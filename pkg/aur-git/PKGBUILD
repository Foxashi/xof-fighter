# Maintainer: Foxashi <https://github.com/Foxashi>
pkgname=xof-fighter-git
_pkgname=xof-fighter
pkgver=r1.0000000
pkgrel=1
pkgdesc="CLI tool for checking player counts (git)"
arch=('x86_64')
url="https://github.com/Foxashi/xof-fighter"
license=('MIT')
depends=()
makedepends=('rust' 'cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_pkgname"
    cargo build --release
}

package() {
    cd "$_pkgname"
    install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
