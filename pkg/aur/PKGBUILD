# Maintainer: Foxashi <https://github.com/Foxashi>
pkgname=xof-fighter
pkgver=0.1.0
pkgrel=1
pkgdesc="CLI tool for checking player counts"
arch=('x86_64')
url="https://github.com/Foxashi/xof-fighter"
license=('MIT')
depends=()
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
# Update sha256sums before publishing:
#   curl -L $url/archive/v$pkgver.tar.gz | sha256sum

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
